{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/reactivity": "^0.43.0",
        "@esportsplus/utilities": "^0.28.6"
    },
    "devDependencies": {
        "@esportsplus/typescript": "^0.42.0",
        "@types/node": "^26.6.6",
        "happy-dom": "^21.0.4",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        "./client": {
            "types": "./build/client/index.d.ts",
            "default": "./build/client/index.js"
        }
    },
    "files": [
        "build"
    ],
    "name": "@esportsplus/routing",
    "packageManager": "pnpm@11.10.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/routing"
    },
    "scripts": {
        "bench": "vitest bench --run --reporter=verbose",
        "build": "tsc -p tsconfig.build.json",
        "lint": "oxlint -c oxlintrc.json --type-aware --deny-warnings",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
        "-": "-",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build"
    },
    "type": "module",
    "version": "0.11.10"
}
